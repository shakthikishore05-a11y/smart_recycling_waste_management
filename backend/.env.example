# Smart Recycling Waste Management System - Backend Environment Configuration

# Security & Authentication
SECRET_KEY=smart_recycling_secure_jwt_secret_key_change_in_production_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is local SQLite for standalone execution. For PostgreSQL/Supabase, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_recycling
DATABASE_URL=sqlite:///./waste_management.db

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# AI Classification Model
MODEL_WEIGHTS_PATH=./app/ml/waste_classifier.pkl
CONFIDENCE_THRESHOLD=0.60

# AI Recycling Assistant LLM API (Optional - Rule-based RAG fallback operates seamlessly if empty)
AI_ASSISTANT_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=

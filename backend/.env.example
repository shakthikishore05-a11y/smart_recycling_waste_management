# Smart Recycling Waste Management System - Environment Configuration
# ==============================================================================
# For Vercel Production Deployments:
# Add these keys in your Vercel Project Settings -> Environment Variables.
#
# NOTE ON DATABASE PERSISTENCE:
# Vercel functions are stateless and ephemeral. Any SQLite database located in /tmp
# will be reset whenever serverless instances recycle.
# For production persistence (user accounts, scan history, recycling logs), provision
# a free managed PostgreSQL database (e.g. Neon https://neon.tech, Supabase https://supabase.com,
# or Vercel Postgres) and supply the connection string below.
# ==============================================================================

# 1. Security & Authentication
# Generate a strong 64-character secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=smart_recycling_secure_jwt_secret_key_change_in_production_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Configuration
# Local development default: sqlite:///./waste_management.db
# Managed PostgreSQL for Vercel production:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/smart_recycling?sslmode=require
DATABASE_URL=sqlite:///./waste_management.db

# 3. Storage Configuration
# Local default: ./uploads
# Vercel default: /tmp/uploads (automatically detected when VERCEL=1)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# 4. AI Waste Classifier Model
# Automatically resolves to backend/app/ml/waste_classifier.pkl if left empty
MODEL_WEIGHTS_PATH=
CONFIDENCE_THRESHOLD=0.60

# 5. AI Recycling Assistant (Optional External LLM)
# Default 'rule_based' operates 100% offline with zero external API dependencies
AI_ASSISTANT_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=
